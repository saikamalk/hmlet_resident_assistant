# Copy to .env and fill in your own values. Never commit .env.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_RETRIES=2
MIN_RETRIEVAL_SCORE=0.2

APP_ENV=development
AUTH_DISABLED=true
AUTH_JWKS_URL=
AUTH_ISSUER=
AUTH_AUDIENCE=

REDIS_URL=
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

RESIDENT_DATA_DIR=data
RESIDENT_ACTION_DB=data/actions.sqlite3
RESIDENT_SESSION_DB=data/sessions.sqlite3
